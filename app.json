{
  "expo": {
    "name": "Cabinet",
    "slug": "medicine",
    "scheme": "cabinet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E9E6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nodedesign.cabinet",
      "infoPlist": {
        "NSCameraUsageDescription": "Cabinet uses the camera to scan the medicine box or strip you are holding."
      }
    },
    "android": {
      "package": "com.nodedesign.cabinet",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#E9E6FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Cabinet uses the camera to scan the medicine box or strip you are holding."
        }
      ]
    ]
  }
}
